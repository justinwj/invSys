{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invsys.local/schemas/vba-dynamic-roots-1.0.0.json",
  "title": "invSys VBA Dynamic Root Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportType", "roots", "exceptions"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "reportType": { "const": "vba-dynamic-root-registry" },
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rootKind",
          "matchType",
          "componentPattern",
          "procedurePattern",
          "reason"
        ],
        "properties": {
          "id": { "type": "string" },
          "rootKind": {
            "enum": [
              "RIBBON_CALLBACK",
              "AUTO_OPEN",
              "WORKBOOK_EVENT",
              "USERFORM_EVENT",
              "WORKSHEET_EVENT",
              "PROCESSOR_HANDLER",
              "STRING_DISPATCH",
              "CROSS_XLAM_BRIDGE",
              "TEST_ENTRY",
              "WINDOWS_CALLBACK",
              "COMPATIBILITY_SHIM"
            ]
          },
          "matchType": { "enum": ["EXACT", "REGEX"] },
          "componentPattern": { "type": "string" },
          "procedurePattern": { "type": "string" },
          "sourcePathPattern": { "type": ["string", "null"] },
          "reason": { "type": "string" }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "componentPattern",
          "procedurePattern",
          "disposition",
          "reason",
          "reviewedBy"
        ],
        "properties": {
          "id": { "type": "string" },
          "componentPattern": { "type": "string" },
          "procedurePattern": { "type": "string" },
          "disposition": { "enum": ["RETAIN", "INVESTIGATE", "MIGRATE"] },
          "reason": { "type": "string" },
          "reviewedBy": { "type": "string" }
        }
      }
    }
  }
}
