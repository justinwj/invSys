{
  "schemaVersion": "1.0.0",
  "reportType": "vba-dynamic-root-registry",
  "roots": [
    {
      "id": "convention.ribbon",
      "rootKind": "RIBBON_CALLBACK",
      "matchType": "REGEX",
      "componentPattern": ".*",
      "procedurePattern": "^Ribbon[A-Za-z0-9_]+$",
      "sourcePathPattern": null,
      "reason": "RibbonX callback names are invoked by Office rather than direct VBA calls."
    },
    {
      "id": "convention.auto-open",
      "rootKind": "AUTO_OPEN",
      "matchType": "EXACT",
      "componentPattern": ".*",
      "procedurePattern": "Auto_Open",
      "sourcePathPattern": null,
      "reason": "Excel invokes Auto_Open by convention."
    },
    {
      "id": "convention.workbook-event",
      "rootKind": "WORKBOOK_EVENT",
      "matchType": "REGEX",
      "componentPattern": "^ThisWorkbook$",
      "procedurePattern": "^Workbook_",
      "sourcePathPattern": null,
      "reason": "Workbook event procedures are invoked by Excel."
    },
    {
      "id": "convention.userform-event",
      "rootKind": "USERFORM_EVENT",
      "matchType": "REGEX",
      "componentPattern": ".*",
      "procedurePattern": "^(UserForm_|[A-Za-z0-9_]+_(Click|Change|Enter|Exit|Initialize|Terminate|QueryClose))",
      "sourcePathPattern": ".*\\.frm$",
      "reason": "UserForm and control events are convention-dispatched."
    },
    {
      "id": "convention.worksheet-event",
      "rootKind": "WORKSHEET_EVENT",
