# Only the seven canonical XLAMs directly under deploy/current are source-controlled.
# Build, candidate, hotfix, validation, and local archive packages are disposable.
deploy/**/.build-staging-*/
deploy/candidate-*/
deploy/hotfix-*/
deploy/validation-*/
deploy/archive/

# Temporary Excel harness workbooks created by integration runners
tests/fixtures/*_Harness_*.xlsm

# Temporary validation roots and ad hoc slice result files
tests/tmp/
tests/unit/phase6_test_results_*.md

# Local machine/session artifacts
build_xlam_run.log
xlam_session_status.txt
~$*.xlam
*.code-workspace

# Local scratch/render artifacts not part of the product
tikz_playground.aux
tikz_playground.fdb_latexmk
tikz_playground.fls
tikz_playground.log
tests/fixtures/invSys.Inbox.Production.S1.xlsb
tests/fixtures/invSys.Inbox.Receiving.S1.xlsb
tests/fixtures/invSys.Inbox.Shipping.S1.xlsb
tests/fixtures/WH1.invSys.Auth.sample.xlsx
tests/fixtures/WH1.invSys.Auth.xlsb
tests/fixtures/WH1.invSys.Config.sample.xlsx
tests/fixtures/WH1.invSys.Config.xlsb
tests/fixtures/WH1.invSys.Data.Inventory.xlsb
